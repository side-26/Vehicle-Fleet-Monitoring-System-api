{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-debugger": "error",
    "no-console": "warn",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.\\./",
            "message": "Parent imports are forbidden. Use the #/ alias instead."
          },
          {
            "regex": "^(\\./|\\.\\./|#).*\\.(js|mjs|cjs)$",
            "message": "Use TypeScript extensions (.ts or .mts) instead of JavaScript extensions."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**"]
}
