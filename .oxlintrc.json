{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-debugger": "error",
    "no-console": "warn"
  },
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**"]
}
